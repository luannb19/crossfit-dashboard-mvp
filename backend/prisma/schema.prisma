// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(ALUNO)
  name      String
  createdAt DateTime @default(now())
  Attendance Attendance[]
}

model Class {
  id        String   @id @default(cuid())
  title     String
  startAt   DateTime
  endAt     DateTime
  capacity  Int
  createdAt DateTime @default(now())
  Attendance Attendance[]
}

model Attendance {
  id         String   @id @default(cuid())
  userId     String
  classId    String
  attendedAt DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])
  Class      Class    @relation(fields: [classId], references: [id])
}

enum Role {
  ALUNO
  COACH
  GESTOR
}

enum WorkoutCategory {
  METCON
  STRENGTH
  TECHNIQUE
  MOBILITY
}



// --- Pagamentos pontuais (Checkout "payment": IA 30 dias) ---
model Payment {
  id               String   @id @default(cuid())
  // chaves da Stripe
  stripeSessionId  String   @unique
  stripeIntentId   String?  @unique
  stripeCustomerId String?
  priceId          String?

  // dados de valor
  amount           Int?     // em centavos
  currency         String?  // "brl", etc.

  // "requires_payment_method" | "processing" | "succeeded" | ...
  status           String

  // "payment" | "subscription"
  mode             String

  customerEmail    String?
  userId           String?  // se você vincular usuários por e-mail/ID depois

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerEmail])
  @@index([mode, status])
}

// --- Assinaturas (Checkout "subscription": Plano Mensal) ---
model Subscription {
  id                String   @id @default(cuid())
  stripeSubId       String   @unique
  stripeCustomerId  String?
  priceId           String?
  status            String   // "trialing" | "active" | "past_due" | "canceled" | "incomplete" | ...
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean? @default(false)

  customerEmail     String?
  userId            String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerEmail])
  @@index([status])
}

// --- model workout ---
model Workout {
  id          String          @id @default(cuid())

  // Relacionamento com a box/dono (ajuste o tipo conforme seu modelo de Box)
  boxId       String
  // box         Box             @relation(fields: [boxId], references: [id])

  date        DateTime        // “dia do treino” (podemos usar 00:00 da box)
  title       String
  description String?

  category    WorkoutCategory

  videoUrl    String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

